# ════════════════════════════════════════════════════════════
#  MONITOR .env  —  trade/.env
#  Copy this file to .env and fill in the values marked REQUIRED.
#  Everything else has working defaults and is optional.
# ════════════════════════════════════════════════════════════

# ── Telegram (REQUIRED to receive alerts on your phone) ──────────────────────
#
# Step 1: Create a bot
#   1. Open Telegram and search for @BotFather
#   2. Send: /newbot
#   3. Follow the prompts (give it any name and username)
#   4. BotFather replies with a token — copy it below
#
TELEGRAM_BOT_TOKEN=            # e.g. 7412345678:AAFxyz...

# Step 2: Get your chat ID
#   1. Search for @userinfobot on Telegram
#   2. Send: /start
#   3. It replies with your numeric ID — copy it below
#
TELEGRAM_CHAT_ID=              # e.g. 987654321

# ── Executor Connection (REQUIRED if you want to execute trades) ──────────────
#
# The executor is a separate process (trade/executor/server.py).
# Run it in a second terminal: cd trade/executor && python server.py
# Default port is 8100 — only change if something else is using that port.
#
EXECUTOR_URL=http://localhost:8100

# ── Position Sizing ───────────────────────────────────────────────────────────
MAX_RISK_PER_TRADE=50          # max $ to risk per trade (default: $50)
UNDERDOG_MAX_PRICE=0.45        # only suggest entries below this YES price

# ── Polling Intervals ─────────────────────────────────────────────────────────
ARBITRAGE_POLL_SECONDS=30      # how often to scan for arbitrage (default: 30s)
ENTRY_POLL_SECONDS=60          # how often to scan for entry signals (default: 60s)
ARBITRAGE_MIN_EDGE=0.02        # minimum edge % to alert on arbitrage (default: 2%)

# ── Run Detection Thresholds (optional, defaults shown) ──────────────────────
# A "run" fires an exit alert when a team you hold scores enough points
# within a time window with limited opponent scoring.
#
# Format: _PTS = min points to score, _OPP = max opponent points allowed, _WINDOW = seconds
#
RUN_NBA_PTS=8                  # e.g. 8-0 run in 3 minutes
RUN_NBA_OPP=2
RUN_NBA_WINDOW=180

RUN_MLB_PTS=3                  # e.g. 3 runs with no answer
RUN_MLB_OPP=0
RUN_MLB_WINDOW=600

RUN_NHL_PTS=2                  # e.g. 2 goals in 5 minutes
RUN_NHL_OPP=0
RUN_NHL_WINDOW=300

RUN_UFC_PTS=1                  # any round-end event is high signal
RUN_UFC_OPP=99
RUN_UFC_WINDOW=600

RUN_ATP_PTS=3                  # 3 consecutive games
RUN_ATP_OPP=0
RUN_ATP_WINDOW=600

RUN_WTA_PTS=3
RUN_WTA_OPP=0
RUN_WTA_WINDOW=600

RUN_COOLDOWN=120               # seconds before re-alerting on the same team's run

# ── Paper trading (run_server.py) ─────────────────────────────────────────────
PAPER_BALANCE=10000            # starting paper wallet
SETTLEMENT_INTERVAL=300        # seconds between settlement scans for resolved games
# Entries are game-winner moneylines only (KXNBAGAME, KXMLBGAME, KXNHLGAME).
# Parlays, spreads, totals, and player props are excluded.
