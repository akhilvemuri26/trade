# ════════════════════════════════════════════════════════════
#  EXECUTOR .env  —  trade/executor/.env
#  Copy this file to .env and fill in your Kalshi API key info.
# ════════════════════════════════════════════════════════════

# ── Kalshi API Key (REQUIRED) ────────────────────────────────────────────────
#
# How to get these:
#
#   FOR DEMO (start here):
#   1. Go to https://demo.kalshi.co and create a free account
#   2. Go to Profile → API Keys → Generate New Key
#   3. Copy the Key ID below
#   4. Download the private key PEM file and save it in this directory
#   5. Add demo funds: Settings → Wallet → Deposit (use test payment method)
#      Load at least $5,000 for running parallel strategy tests
#
#   FOR PRODUCTION (switch to this when ready to trade real money):
#   1. Go to https://kalshi.com → Profile → API Keys → Generate New Key
#   2. Verify your identity if you haven't already
#   3. Deposit real funds
#   4. Change KALSHI_ENV to "production" below
#
KALSHI_KEY_ID=                # e.g. abc123-def456-ghi789
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# ── Environment ───────────────────────────────────────────────────────────────
# "demo" = fake money, safe to test (https://demo-api.kalshi.com)
# "production" = real money, real trades (https://api.elections.kalshi.com)
KALSHI_ENV=demo

# ── Executor Config ───────────────────────────────────────────────────────────
EXECUTOR_PORT=8100
